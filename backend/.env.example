# Hacknation - Reasoning Layer environment template.
# Copy to .env and fill in for local dev (.env is gitignored).

# Mode switch: "mock" reads from backend/fixtures/, "real" reads from Databricks Unity Catalog gold tables.
HACKATHON_MODE=mock

# MLflow tracking. Default uses local ./mlruns directory.
MLFLOW_TRACKING_URI=./mlruns
MLFLOW_EXPERIMENT_NAME=hacknation-reasoning

# Databricks (only needed when HACKATHON_MODE=real).
DATABRICKS_SERVER_HOSTNAME=
DATABRICKS_HTTP_PATH=
DATABRICKS_TOKEN=
DATABRICKS_CATALOG=maarg
DATABRICKS_SCHEMA=truth_layer
DATABRICKS_FACILITY_TRUST_TABLE=gold_facility_trust
DATABRICKS_PIN_DESERT_TABLE=gold_pin_desert

# FastAPI server.
REASONING_API_HOST=0.0.0.0
REASONING_API_PORT=8000
