{
  "name": "hacknation",
  "private": true,
  "description": "Run the Maarg app from the repo root (no need to cd into frontend)",
  "scripts": {
    "dev": "npm run dev --prefix ./frontend",
    "dev:recover": "npm run dev:recover --prefix ./frontend",
    "build": "npm run build --prefix ./frontend",
    "start": "npm run start --prefix ./frontend",
    "install:web": "npm install --prefix ./frontend",
    "clean": "npm run clean:next --prefix ./frontend",
    "rebuild": "npm run rebuild --prefix ./frontend"
  }
}
