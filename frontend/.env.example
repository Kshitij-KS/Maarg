# Public base URL of the FastAPI backend (default works for local dev).
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Mapbox public access token — required for the live map on /search and /map.
# Get a free token at https://account.mapbox.com/access-tokens/
# The map shows a styled placeholder when this is empty.
NEXT_PUBLIC_MAPBOX_TOKEN=

# Supabase (optional — only if you use @/utils/supabase/*)
# Create a project at https://supabase.com — use the Project URL and publishable (anon) key.
# Never commit the service role / secret key; use it only in server workers or edge functions.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
