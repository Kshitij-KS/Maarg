{
  "openapi": "3.1.0",
  "info": {
    "title": "Hacknation Reasoning Auditor API",
    "description": "FastAPI service for Person B's v2 reasoning layer.",
    "version": "0.0.2"
  },
  "paths": {
    "/api/query": {
      "post": {
        "tags": [
          "query"
        ],
        "summary": "Query",
        "operationId": "query_api_query_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/QueryRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/QueryResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/facility/{facility_id}": {
      "get": {
        "tags": [
          "facility"
        ],
        "summary": "Facility",
        "operationId": "facility_api_facility__facility_id__get",
        "parameters": [
          {
            "name": "facility_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Facility Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FacilityTrustRecord"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/desert": {
      "get": {
        "tags": [
          "desert"
        ],
        "summary": "Desert",
        "operationId": "desert_api_desert_get",
        "parameters": [
          {
            "name": "capability",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Capability"
            }
          },
          {
            "name": "state",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "State"
            }
          },
          {
            "name": "pin_code",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Pin Code"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/PinCodeDesert"
                  },
                  "title": "Response Desert Api Desert Get"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/trace/{trace_id}": {
      "get": {
        "tags": [
          "trace"
        ],
        "summary": "Trace",
        "operationId": "trace_api_trace__trace_id__get",
        "parameters": [
          {
            "name": "trace_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Trace Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TraceResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/demo-scenarios": {
      "get": {
        "tags": [
          "demo"
        ],
        "summary": "Demo Scenarios",
        "operationId": "demo_scenarios_api_demo_scenarios_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DemoScenariosResponse"
                }
              }
            }
          }
        }
      }
    },
    "/healthz": {
      "get": {
        "summary": "Healthz",
        "operationId": "healthz_healthz_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "CapabilityClaim": {
        "properties": {
          "capability": {
            "type": "string",
            "title": "Capability"
          },
          "claim_present": {
            "type": "boolean",
            "title": "Claim Present"
          },
          "self_consistency_score": {
            "type": "number",
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Self Consistency Score"
          },
          "coherence_score": {
            "type": "number",
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Coherence Score"
          },
          "peer_anomaly_score": {
            "type": "number",
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Peer Anomaly Score"
          },
          "trust_score": {
            "type": "number",
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Trust Score"
          },
          "confidence_interval_low": {
            "type": "number",
            "title": "Confidence Interval Low"
          },
          "confidence_interval_high": {
            "type": "number",
            "title": "Confidence Interval High"
          },
          "citations": {
            "items": {
              "$ref": "#/components/schemas/Citation"
            },
            "type": "array",
            "title": "Citations"
          },
          "flags": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Flags"
          }
        },
        "type": "object",
        "required": [
          "capability",
          "claim_present",
          "self_consistency_score",
          "coherence_score",
          "peer_anomaly_score",
          "trust_score",
          "confidence_interval_low",
          "confidence_interval_high",
          "citations"
        ],
        "title": "CapabilityClaim",
        "description": "One row per (facility, capability). The atomic unit of trust."
      },
      "Citation": {
        "properties": {
          "source_field": {
            "type": "string",
            "title": "Source Field"
          },
          "sentence": {
            "type": "string",
            "title": "Sentence"
          },
          "char_start": {
            "type": "integer",
            "title": "Char Start"
          },
          "char_end": {
            "type": "integer",
            "title": "Char End"
          }
        },
        "type": "object",
        "required": [
          "source_field",
          "sentence",
          "char_start",
          "char_end"
        ],
        "title": "Citation",
        "description": "Exact provenance for any extracted fact."
      },
      "DemoScenario": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "label": {
            "type": "string",
            "title": "Label"
          },
          "description": {
            "type": "string",
            "title": "Description"
          },
          "request": {
            "$ref": "#/components/schemas/QueryRequest"
          }
        },
        "type": "object",
        "required": [
          "id",
          "label",
          "description",
          "request"
        ],
        "title": "DemoScenario"
      },
      "DemoScenariosResponse": {
        "properties": {
          "scenarios": {
            "items": {
              "$ref": "#/components/schemas/DemoScenario"
            },
            "type": "array",
            "title": "Scenarios"
          }
        },
        "type": "object",
        "required": [
          "scenarios"
        ],
        "title": "DemoScenariosResponse"
      },
      "FacilityTrustRecord": {
        "properties": {
          "facility_id": {
            "type": "string",
            "title": "Facility Id"
          },
          "facility_name": {
            "type": "string",
            "title": "Facility Name"
          },
          "pin_code": {
            "type": "string",
            "title": "Pin Code"
          },
          "state": {
            "type": "string",
            "title": "State"
          },
          "district": {
            "type": "string",
            "title": "District"
          },
          "lat": {
            "type": "number",
            "title": "Lat"
          },
          "lon": {
            "type": "number",
            "title": "Lon"
          },
          "facility_type": {
            "type": "string",
            "title": "Facility Type"
          },
          "capabilities": {
            "items": {
              "$ref": "#/components/schemas/CapabilityClaim"
            },
            "type": "array",
            "title": "Capabilities"
          },
          "overall_trust_score": {
            "type": "number",
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Overall Trust Score"
          },
          "extraction_run_ids": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Extraction Run Ids"
          },
          "last_updated": {
            "type": "string",
            "format": "date-time",
            "title": "Last Updated"
          }
        },
        "type": "object",
        "required": [
          "facility_id",
          "facility_name",
          "pin_code",
          "state",
          "district",
          "lat",
          "lon",
          "facility_type",
          "capabilities",
          "overall_trust_score",
          "extraction_run_ids",
          "last_updated"
        ],
        "title": "FacilityTrustRecord",
        "description": "One row per facility in `gold.facility_trust`."
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "HealthResponse": {
        "properties": {
          "ok": {
            "type": "boolean",
            "title": "Ok"
          },
          "mode": {
            "type": "string",
            "enum": [
              "mock",
              "real"
            ],
            "title": "Mode"
          }
        },
        "type": "object",
        "required": [
          "ok",
          "mode"
        ],
        "title": "HealthResponse"
      },
      "PinCodeDesert": {
        "properties": {
          "pin_code": {
            "type": "string",
            "title": "Pin Code"
          },
          "state": {
            "type": "string",
            "title": "State"
          },
          "district": {
            "type": "string",
            "title": "District"
          },
          "lat": {
            "type": "number",
            "title": "Lat"
          },
          "lon": {
            "type": "number",
            "title": "Lon"
          },
          "population": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Population"
          },
          "capability": {
            "type": "string",
            "title": "Capability"
          },
          "nearest_verified_facility_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Nearest Verified Facility Id"
          },
          "distance_km": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Distance Km"
          },
          "desert_score": {
            "type": "number",
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Desert Score"
          }
        },
        "type": "object",
        "required": [
          "pin_code",
          "state",
          "district",
          "lat",
          "lon",
          "capability",
          "desert_score"
        ],
        "title": "PinCodeDesert",
        "description": "One row per (pin_code, capability) in `gold.pin_code_desert`."
      },
      "QueryRequest": {
        "properties": {
          "text": {
            "type": "string",
            "title": "Text"
          },
          "user_lat": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "User Lat"
          },
          "user_lon": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "User Lon"
          },
          "max_distance_km": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Max Distance Km"
          },
          "min_trust_score": {
            "type": "number",
            "title": "Min Trust Score",
            "default": 0.5
          },
          "capabilities_filter": {
            "anyOf": [
              {
                "items": {
                  "type": "string"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "title": "Capabilities Filter"
          },
          "top_k": {
            "type": "integer",
            "title": "Top K",
            "default": 10
          }
        },
        "type": "object",
        "required": [
          "text"
        ],
        "title": "QueryRequest",
        "description": "User query into the Coordinator agent."
      },
      "QueryResponse": {
        "properties": {
          "query": {
            "type": "string",
            "title": "Query"
          },
          "candidates": {
            "items": {
              "$ref": "#/components/schemas/FacilityTrustRecord"
            },
            "type": "array",
            "title": "Candidates"
          },
          "citations_per_candidate": {
            "additionalProperties": {
              "items": {
                "$ref": "#/components/schemas/Citation"
              },
              "type": "array"
            },
            "type": "object",
            "title": "Citations Per Candidate"
          },
          "critic_verdict": {
            "type": "string",
            "enum": [
              "supported",
              "partial",
              "unsupported"
            ],
            "title": "Critic Verdict"
          },
          "critic_reasoning": {
            "type": "string",
            "title": "Critic Reasoning"
          },
          "trace_id": {
            "type": "string",
            "title": "Trace Id"
          }
        },
        "type": "object",
        "required": [
          "query",
          "candidates",
          "citations_per_candidate",
          "critic_verdict",
          "critic_reasoning",
          "trace_id"
        ],
        "title": "QueryResponse",
        "description": "The thing the (eventual) frontend renders."
      },
      "TraceResponse": {
        "properties": {
          "trace_id": {
            "type": "string",
            "title": "Trace Id"
          },
          "found": {
            "type": "boolean",
            "title": "Found"
          },
          "spans": {
            "items": {
              "$ref": "#/components/schemas/TraceSpan"
            },
            "type": "array",
            "title": "Spans"
          }
        },
        "type": "object",
        "required": [
          "trace_id",
          "found",
          "spans"
        ],
        "title": "TraceResponse"
      },
      "TraceSpan": {
        "properties": {
          "name": {
            "type": "string",
            "title": "Name"
          },
          "span_type": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Span Type"
          },
          "start_time_ms": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Start Time Ms"
          },
          "end_time_ms": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "End Time Ms"
          },
          "attributes": {
            "additionalProperties": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                },
                {
                  "type": "number"
                },
                {
                  "type": "boolean"
                },
                {
                  "type": "null"
                }
              ]
            },
            "type": "object",
            "title": "Attributes",
            "default": {}
          }
        },
        "type": "object",
        "required": [
          "name"
        ],
        "title": "TraceSpan"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}